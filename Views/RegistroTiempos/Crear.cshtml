@model ConsultoriaApp.Models.RegistroTiempo
@{
    ViewData["Title"] = "Registrar Tiempo";
}

<h2><i class="bi bi-clock me-1"></i>Registrar Tiempo</h2>
<p class="text-muted">Tarea: <strong>@ViewBag.Tarea?.Nombre</strong></p>

<div class="card shadow-sm p-4" style="max-width:500px">
    <form asp-action="Crear" method="post">
        <input asp-for="TareaId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Fecha" class="form-label"></label>
            <input asp-for="Fecha" type="date" class="form-control" />
        </div>
        <div class="row">
            <div class="col mb-3">
                <label asp-for="HoraInicio" class="form-label"></label>
                <input asp-for="HoraInicio" type="time" class="form-control" />
            </div>
            <div class="col mb-3">
                <label asp-for="HoraFin" class="form-label"></label>
                <input asp-for="HoraFin" type="time" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i>Guardar
            </button>
            <a asp-controller="Proyectos" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}