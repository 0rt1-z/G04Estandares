@model List<ConsultoriaApp.Models.Proyecto>
@{
    ViewData["Title"] = "Proyectos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-briefcase-fill me-2"></i>Proyectos</h2>
    @if (User.IsInRole("Administrador") || User.IsInRole("Lider"))
    {
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Proyecto
        </a>
    }
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Exito"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var p in Model)
    {
        var costoReal = (decimal)(ViewData[$"Costo_{p.Id}"] ?? 0);
        var pct = p.Presupuesto > 0 ? (costoReal / p.Presupuesto) * 100 : 0;
        var barClass = pct >= 100 ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success";

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-header d-flex justify-content-between">
                    <strong>@p.Nombre</strong>
                    <span class="badge bg-@(p.Estado == "Activo" ? "success" : p.Estado == "Pausado" ? "warning" : "secondary")">
                        @p.Estado
                    </span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-1">
                        <i class="bi bi-calendar3"></i> @p.FechaInicio.ToString("dd/MM/yyyy") — @p.FechaFin.ToString("dd/MM/yyyy")
                    </p>
                    <p class="mb-1"><strong>Presupuesto:</strong> $@p.Presupuesto.ToString("N2")</p>
                    <p class="mb-1"><strong>Costo real:</strong> $@costoReal.ToString("N2")</p>
                    <div class="progress mt-2" style="height:8px">
                        <div class="progress-bar @barClass" style="width:@Math.Min(pct, 100)%"></div>
                    </div>
                    <small class="text-muted">@pct.ToString("N1")% ejecutado</small>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Ver
                    </a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Lider"))
                    {
                        <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Eliminar" asp-route-id="@p.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('¿Eliminar proyecto?')">
                            <i class="bi bi-trash"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>